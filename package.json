{
  "name": "tangtang-notes",
  "version": "1.0.0",
  "description": "糖糖笔记 · 留住每一个灵感",
  "author": "糖糖笔记",
  "private": true,
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test --project=electron",
    "test:packaged": "playwright test --project=packaged",
    "build": "pnpm typecheck && electron-vite build",
    "pack": "pnpm build && electron-builder --dir --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "pnpm build && electron-builder --win --x64 --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
